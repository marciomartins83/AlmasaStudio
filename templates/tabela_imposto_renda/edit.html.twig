{% extends 'base.html.twig' %}

{% block title %}Editar Faixa de IR - {{ parent() }}{% endblock %}

{% block content %}
<div class="container-fluid">
    {% include '_partials/breadcrumb.html.twig' with {
        'items': [
            {'label': 'Financeiro', 'url': path('app_financeiro_index')},
            {'label': 'Tabela de Imposto de Renda', 'url': path('app_tabela_imposto_renda_index')}
        ],
        'current': 'Editar Faixa'
    } %}
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1><i class="fas fa-edit"></i> Editar Faixa de IR</h1>
                <div>
                    <a href="{{ path('app_tabela_imposto_renda_show', {'id': faixa_imposto_renda.id}) }}" class="btn btn-info">
                        <i class="fas fa-eye"></i> Visualizar
                    </a>
                    <a href="{{ path('app_tabela_imposto_renda_index') }}" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
                        <div class="row">
                            <div class="col-md-4">
                                {{ form_row(form.dataVigencia) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_row(form.valorInicial) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_row(form.valorFinal) }}
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-4">
                                {{ form_row(form.aliquota) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_row(form.parcelaDeduzir) }}
                            </div>
                            <div class="col-md-4 d-flex align-items-center">
                                <div class="form-check mt-4">
                                    {{ form_widget(form.ativo) }}
                                    {{ form_label(form.ativo) }}
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save"></i> Salvar Alterações
                                </button>
                                <a href="{{ path('app_tabela_imposto_renda_show', {'id': faixa_imposto_renda.id}) }}" class="btn btn-info ms-2">
                                    <i class="fas fa-eye"></i> Ver Faixa
                                </a>
                                <a href="{{ path('app_tabela_imposto_renda_index') }}" class="btn btn-secondary ms-2">
                                    <i class="fas fa-times"></i> Cancelar
                                </a>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
