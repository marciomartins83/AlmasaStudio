{% extends 'base.html.twig' %}

{% block title %}Tabela de Imposto de Renda - {{ parent() }}{% endblock %}

{% block content %}
<div class="container-fluid">
    {% include '_partials/breadcrumb.html.twig' with {
        'items': [
            {'label': 'Financeiro', 'url': path('app_financeiro_index')}
        ],
        'current': 'Tabela de Imposto de Renda'
    } %}
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1><i class="fas fa-file-invoice-dollar"></i> Tabela de Imposto de Renda</h1>
                <a href="{{ path('app_tabela_imposto_renda_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nova Faixa
                </a>
            </div>

            {% include '_partials/search_panel.html.twig' with {
                filterDefs: pagination.filterDefs,
                filters: pagination.filters,
                routeName: 'app_tabela_imposto_renda_index',
                itemsPerPage: pagination.itemsPerPage,
                sortField: pagination.sortField,
                sortDir: pagination.sortDir
            } %}

            {% include '_partials/sort_panel.html.twig' with {
                sortOptions: pagination.sortOptions,
                sortField: pagination.sortField,
                sortDir: pagination.sortDir,
                routeName: 'app_tabela_imposto_renda_index',
                filters: pagination.filters,
                itemsPerPage: pagination.itemsPerPage
            } %}

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th width="80">ID</th>
                                    <th>Vigência</th>
                                    <th>Faixa (R$)</th>
                                    <th>Alíquota</th>
                                    <th>Parcela a Deduzir</th>
                                    <th>Status</th>
                                    <th width="200">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for faixa in pagination.items %}
                                <tr>
                                    <td>{{ faixa.id }}</td>
                                    <td>{{ faixa.dataVigencia|date('d/m/Y') }}</td>
                                    <td>
                                        {{ faixa.valorInicial|number_format(2, ',', '.') }}
                                        até
                                        {{ faixa.valorFinal is not null ? faixa.valorFinal|number_format(2, ',', '.') : 'sem teto' }}
                                    </td>
                                    <td>{{ faixa.aliquota }}%</td>
                                    <td>{{ faixa.parcelaDeduzir|number_format(2, ',', '.') }}</td>
                                    <td>
                                        {% if faixa.ativo %}
                                            <span class="badge bg-success">Ativo</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inativo</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group-vertical btn-group-sm d-md-none" role="group">
                                            <a href="{{ path('app_tabela_imposto_renda_show', {'id': faixa.id}) }}"
                                               class="btn btn-info btn-sm">
                                                <i class="fas fa-eye"></i> Ver
                                            </a>
                                            <a href="{{ path('app_tabela_imposto_renda_edit', {'id': faixa.id}) }}"
                                               class="btn btn-warning btn-sm">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                        </div>
                                        <div class="btn-group d-none d-md-flex" role="group">
                                            <a href="{{ path('app_tabela_imposto_renda_show', {'id': faixa.id}) }}"
                                               class="btn btn-info btn-sm">
                                                <i class="fas fa-eye"></i> Ver
                                            </a>
                                            <a href="{{ path('app_tabela_imposto_renda_edit', {'id': faixa.id}) }}"
                                               class="btn btn-warning btn-sm">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <form method="post"
                                                  action="{{ path('app_tabela_imposto_renda_delete', {'id': faixa.id}) }}"
                                                  style="display:inline-block"
                                                  data-confirm-delete="Tem certeza que deseja excluir esta faixa?">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete' ~ faixa.id) }}">
                                                <button class="btn btn-danger btn-sm">
                                                    <i class="fas fa-trash"></i> Excluir
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                        <span>Nenhuma faixa de IR cadastrada</span><br>
                                        <small>Clique em "Nova Faixa" para começar</small>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% include '_partials/pagination.html.twig' with {
                        totalItems: pagination.totalItems,
                        currentPage: pagination.currentPage,
                        itemsPerPage: pagination.itemsPerPage,
                        totalPages: pagination.totalPages,
                        search: pagination.search,
                        routeName: 'app_tabela_imposto_renda_index',
                        filters: pagination.filters,
                        sortField: pagination.sortField,
                        sortDir: pagination.sortDir,
                        showSearch: false
                    } %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('crud_filters') }}
{% endblock %}
