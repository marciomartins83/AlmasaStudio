{% extends 'base.html.twig' %}

{% block title %}Cobranças Pendentes - {{ parent() }}{% endblock %}

{% block content %}
<div class="container-fluid">
    {% include '_partials/breadcrumb.html.twig' with {
        'items': [
            {'label': 'Dashboard', 'url': path('app_dashboard')},
            {'label': 'Financeiro', 'url': '#'}
        ],
        'current': 'Cobranças Pendentes'
    } %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Passo 1: gerar a relação de cobranças do período (rascunhos, SEM enviar) #}
    <div class="card mb-3 border-primary">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-file-invoice-dollar"></i> Emissão de boletos em lote
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                <strong>1.</strong> Gere a relação do período &nbsp;·&nbsp;
                <strong>2.</strong> Confira / edite / exclua &nbsp;·&nbsp;
                <strong>3.</strong> Gere o <em>relatório de conferência</em> e aprove &nbsp;·&nbsp;
                <strong>4.</strong> Só então os boletos são emitidos e enviados.
            </p>
            <form method="POST" action="{{ path('app_cobranca_gerar_periodo') }}" class="row g-3 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token('cobranca_gerar_periodo') }}">
                <div class="col-md-3">
                    <label class="form-label">Modo</label>
                    <select class="form-select" name="modo" id="gerModo">
                        <option value="vencimento">Por intervalo de vencimento</option>
                        <option value="competencia">Por competência (mês)</option>
                    </select>
                </div>
                <div class="col-md-3 modo-vencimento">
                    <label class="form-label">Vencimento de</label>
                    <input type="date" class="form-control" name="vencimento_inicio">
                </div>
                <div class="col-md-3 modo-vencimento">
                    <label class="form-label">Vencimento até</label>
                    <input type="date" class="form-control" name="vencimento_fim">
                </div>
                <div class="col-md-3 modo-competencia" style="display:none">
                    <label class="form-label">Competência</label>
                    <input type="month" class="form-control" name="competencia">
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-list-check"></i> Gerar relação
                    </button>
                    <a href="{{ path('app_boleto_new') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-plus"></i> Boleto avulso
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1><i class="fas fa-file-invoice-dollar"></i> Relação de cobranças a emitir</h1>
            </div>

            {# Filtros #}
            <div class="card mb-3">
                <div class="card-body">
                    <form method="GET" action="{{ path('app_cobranca_pendentes') }}" class="row g-3 align-items-end" id="form-filtro-cobranca">
                        <div class="col-md-2">
                            <label for="data_vencimento" class="form-label">Data de Vencimento</label>
                            <input type="date"
                                   class="form-control"
                                   id="data_vencimento"
                                   name="data_vencimento"
                                   value="{{ dataVencimento is not null ? dataVencimento|date('Y-m-d') : '' }}">
                        </div>
                        <div class="col-md-2">
                            <label for="vencimento_inicio" class="form-label">Vencimento de</label>
                            <input type="date"
                                   class="form-control"
                                   id="vencimento_inicio"
                                   name="vencimento_inicio"
                                   value="{{ vencimentoInicio is not null ? vencimentoInicio|date('Y-m-d') : '' }}">
                        </div>
                        <div class="col-md-2">
                            <label for="vencimento_fim" class="form-label">Vencimento até</label>
                            <input type="date"
                                   class="form-control"
                                   id="vencimento_fim"
                                   name="vencimento_fim"
                                   value="{{ vencimentoFim is not null ? vencimentoFim|date('Y-m-d') : '' }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="status[]" multiple>
                                {% for key, label in statusOptions %}
                                    <option value="{{ key }}" {% if key in filtros.status|default([]) %}selected{% endif %}>
                                        {{ label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="mostrar_automaticos"
                                       name="mostrar_automaticos"
                                       value="1"
                                       {% if mostrarAutomaticos %}checked{% endif %}>
                                <label class="form-check-label" for="mostrar_automaticos">
                                    Mostrar envios automáticos
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <span class="text-muted small me-2">Faixas do mês atual:</span>
                            <button type="button" class="btn btn-outline-secondary btn-sm btn-faixa-vencimento" data-inicio="1" data-fim="10">1 a 10</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm btn-faixa-vencimento" data-inicio="11" data-fim="20">11 a 20</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm btn-faixa-vencimento" data-inicio="21" data-fim="31">21 a 31</button>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Filtrar
                            </button>
                            <a href="{{ path('app_cobranca_pendentes') }}" class="btn btn-secondary">
                                <i class="fas fa-eraser"></i> Limpar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            {# Cards de Resumo #}
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ estatisticas.total.quantidade|default(0) }}</h3>
                            <small>Total de Cobranças</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h3 class="mb-0">R$ {{ estatisticas.total.valor|default(0)|number_format(2, ',', '.') }}</h3>
                            <small>Valor Total</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ contagem_tipo_envio.automatico|default(0) }}</h3>
                            <small>Automáticos</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h3 class="mb-0">{{ contagem_tipo_envio.manual|default(0) }}</h3>
                            <small>Manuais</small>
                        </div>
                    </div>
                </div>
            </div>

            {# Passo 3: gerar o relatório de conferência das selecionadas e aprovar #}
            <div class="mb-3">
                <button type="button" class="btn btn-primary" id="btnRelatorioConferencia" disabled>
                    <i class="fas fa-clipboard-check"></i> Gerar Relatório de Conferência (<span id="contadorSelecionados">0</span>)
                </button>
                <button type="button" class="btn btn-outline-success" id="btnAvulso">
                    <i class="fas fa-plus"></i> Boleto avulso (rápido)
                </button>
                <span class="text-muted small ms-2">
                    <i class="fas fa-lock"></i> Os boletos só são emitidos depois que você aprovar o relatório.
                </span>
            </div>

            {# Verificação de pagamento (sob demanda — não roda em horário fixo) #}
            <div class="card mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto"><strong><i class="fas fa-magnifying-glass-dollar"></i> Verificar pagamentos</strong></div>
                        <div class="col-auto">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">Últimos</span>
                                <input type="number" min="1" max="60" value="3" id="verifMeses" class="form-control" style="max-width:80px">
                                <span class="input-group-text">meses</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnAtualizarEmAberto">
                                <i class="fas fa-rotate"></i> Atualizar boletos em aberto
                            </button>
                        </div>
                        <div class="col-auto text-muted small">
                            Consulta os boletos ainda não pagos emitidos dentro da janela e atualiza o status.
                            Boletos individuais: use o botão <i class="fas fa-magnifying-glass-dollar"></i> na linha.
                        </div>
                    </div>
                </div>
            </div>

            {# Tabela de Cobranças #}
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th width="40">
                                        <input type="checkbox" class="form-check-input" id="checkAll">
                                    </th>
                                    <th width="80">Contrato</th>
                                    <th>Imóvel</th>
                                    <th>Locatário</th>
                                    <th width="100">Competência</th>
                                    <th width="100">Vencimento</th>
                                    <th width="120" class="text-end">Valor Total</th>
                                    <th width="100">Tipo</th>
                                    <th width="110">Canal</th>
                                    <th width="120">Status</th>
                                    <th width="150">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for cobranca in cobrancas %}
                                <tr data-id="{{ cobranca.id }}">
                                    <td>
                                        {% if cobranca.podeEnviarManualmente() %}
                                        <input type="checkbox"
                                               class="form-check-input cobranca-check"
                                               value="{{ cobranca.id }}"
                                               data-valor="{{ cobranca.valorTotalFloat }}">
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_contrato_edit', {id: cobranca.contrato.id}) }}">
                                            #{{ cobranca.contrato.id }}
                                        </a>
                                    </td>
                                    <td>
                                        {% if cobranca.contrato.imovel %}
                                            {{ cobranca.contrato.imovel.codigoInterno|default('-') }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if cobranca.contrato.pessoaLocatario %}
                                            {{ cobranca.contrato.pessoaLocatario.nome }}
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                        {% if inadimplentes[cobranca.id] is defined %}
                                            <span class="badge bg-danger ms-1" title="Tem lançamento anterior vencido e não pago">
                                                <i class="fas fa-triangle-exclamation"></i> Inadimplente
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>{{ cobranca.competenciaFormatada }}</td>
                                    <td>{{ cobranca.dataVencimento|date('d/m/Y') }}</td>
                                    <td class="text-end">
                                        <strong>R$ {{ cobranca.valorTotalFloat|number_format(2, ',', '.') }}</strong>
                                    </td>
                                    <td>
                                        {% if cobranca.tipoEnvio == 'AUTOMATICO' %}
                                            <span class="badge bg-info">Automático</span>
                                        {% elseif cobranca.tipoEnvio == 'MANUAL' %}
                                            <span class="badge bg-warning text-dark">Manual</span>
                                        {% else %}
                                            <span class="badge bg-secondary">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">{{ cobranca.canalEnvioLabel }}</span>
                                    </td>
                                    <td>
                                        <span class="badge {{ cobranca.statusClass }}">
                                            {{ cobranca.statusLabel }}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_cobranca_show', {id: cobranca.id}) }}"
                                               class="btn btn-info btn-sm"
                                               title="Ver Detalhes">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            {% if cobranca.boleto %}
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm btn-verificar-pgto"
                                                    data-id="{{ cobranca.id }}"
                                                    title="Verificar pagamento deste boleto">
                                                <i class="fas fa-magnifying-glass-dollar"></i>
                                            </button>
                                            {% endif %}
                                            {% if cobranca.podeEnviarManualmente() %}
                                            <button type="button"
                                                    class="btn btn-success btn-sm btn-enviar"
                                                    data-id="{{ cobranca.id }}"
                                                    title="Enviar">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                            {% endif %}
                                            {% if cobranca.podeMarcarEntregue() %}
                                            <button type="button"
                                                    class="btn btn-primary btn-sm btn-marcar-entregue"
                                                    data-id="{{ cobranca.id }}"
                                                    title="Marcar como Entregue">
                                                <i class="fas fa-hand-holding"></i>
                                            </button>
                                            {% endif %}
                                            {% if cobranca.isPendente() %}
                                            <button type="button"
                                                    class="btn btn-warning btn-sm btn-editar-itens"
                                                    data-id="{{ cobranca.id }}"
                                                    title="Editar itens (aluguel, água, luz, IPTU, condomínio...)">
                                                <i class="fas fa-pen"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-danger btn-sm btn-cancelar"
                                                    data-id="{{ cobranca.id }}"
                                                    title="Excluir da relação">
                                                <i class="fas fa-times"></i>
                                            </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="11" class="text-center text-muted py-4">
                                        <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                        <span>Nenhuma cobrança encontrada</span><br>
                                        <small>Altere os filtros para ver mais resultados</small>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Paginação #}
                    {% if totalPages > 1 %}
                    <nav aria-label="Paginação" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item {% if page == 1 %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_cobranca_pendentes', queryParams|merge({page: page - 1})) }}">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            {% for p in 1..totalPages %}
                                {% if p == page or (p >= page - 2 and p <= page + 2) or p == 1 or p == totalPages %}
                                    <li class="page-item {% if p == page %}active{% endif %}">
                                        <a class="page-link" href="{{ path('app_cobranca_pendentes', queryParams|merge({page: p})) }}">
                                            {{ p }}
                                        </a>
                                    </li>
                                {% elseif p == page - 3 or p == page + 3 %}
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                {% endif %}
                            {% endfor %}
                            <li class="page-item {% if page == totalPages %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_cobranca_pendentes', queryParams|merge({page: page + 1})) }}">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    {% endif %}
                </div>
            </div>

            {% if cobrancas|length > 0 %}
            <div class="mt-2">
                <small class="text-muted">
                    Mostrando {{ cobrancas|length }} de {{ total }} cobrança(s)
                </small>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{# Modal de Preview #}
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-clipboard-check"></i> Relatório de Conferência
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="previewContent">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Voltar e revisar</button>
                <button type="button" class="btn btn-success" id="btnConfirmarEnvio">
                    <i class="fas fa-check-double"></i> Aprovar e emitir boletos
                </button>
            </div>
        </div>
    </div>
</div>

{# Modal de Resultado do Lote #}
<div class="modal fade" id="resultadoLoteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle"></i> Resultado do Envio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="resultadoLoteContent">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="location.reload()">
                    <i class="fas fa-sync"></i> Atualizar Lista
                </button>
            </div>
        </div>
    </div>
</div>

{# Modal de Edição de Itens da Cobrança #}
<div class="modal fade" id="editItensModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-pen"></i> Editar itens — <span id="editItensCompetencia"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="editItensAviso" class="alert alert-warning" style="display:none">
                    Esta cobrança não está mais pendente e não pode ser editada.
                </div>
                <p class="text-muted small">Um boleto pode ter vários itens (aluguel, água, luz, IPTU,
                    condomínio) ou uma linha avulsa. Ajuste, inclua ou remova linhas — o total é recalculado.</p>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th width="220">Tipo</th>
                                <th>Descrição</th>
                                <th width="140" class="text-end">Valor (R$)</th>
                                <th width="50"></th>
                            </tr>
                        </thead>
                        <tbody id="editItensBody"></tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddItem">
                    <i class="fas fa-plus"></i> Adicionar item
                </button>
                <div class="text-end mt-2">
                    <strong>Total: <span id="editItensTotal">R$ 0,00</span></strong>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnSalvarItens">
                    <i class="fas fa-save"></i> Salvar itens
                </button>
            </div>
        </div>
    </div>
</div>

{# Modal de Boleto Avulso (fora de contrato) #}
<div class="modal fade" id="avulsoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus"></i> Boleto avulso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Cobrança avulsa para qualquer pagador (ex.: um serviço de pedreiro,
                    material...). Vários itens somam no total; a composição vai itemizada no boleto.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Pagador <span class="text-danger">*</span></label>
                        {% include '_partials/autocomplete_field.html.twig' with {
                            id: 'avulso_pagador',
                            name: 'avulso_pagador',
                            url: path('app_autocomplete_pessoas'),
                            placeholder: 'Digite o nome do pagador'
                        } %}
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Config. bancária <span class="text-danger">*</span></label>
                        <select class="form-select" id="avulsoConfig">
                            {% for c in configsApi %}
                                <option value="{{ c.id }}">{{ c.ambiente|capitalize }} (#{{ c.id }})</option>
                            {% else %}
                                <option value="">Nenhuma config. ativa</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Vencimento <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="avulsoVenc">
                    </div>
                </div>
                <hr>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead class="table-dark"><tr>
                            <th width="220">Tipo</th><th>Descrição</th>
                            <th width="140" class="text-end">Valor (R$)</th><th width="50"></th>
                        </tr></thead>
                        <tbody id="avulsoItensBody"></tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnAvulsoAddItem">
                    <i class="fas fa-plus"></i> Adicionar item
                </button>
                <div class="text-end mt-2"><strong>Total: <span id="avulsoTotal">R$ 0,00</span></strong></div>
                <div class="alert alert-warning mt-2 mb-0 small">
                    <i class="fas fa-triangle-exclamation"></i> Ao aprovar, o boleto avulso é gerado e enviado por e-mail ao pagador.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnAvulsoEmitir">
                    <i class="fas fa-check-double"></i> Aprovar e emitir
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    window.COBRANCA_ROUTES = {
        enviar: '{{ path('app_cobranca_enviar', {id: '__ID__'}) }}',
