<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Relatório de Conferência de Cobranças</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: DejaVu Sans, sans-serif; font-size: 10px; line-height: 1.4; color: #333; }
        .container { padding: 15px; }
        table.dados { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
        table.dados th, table.dados td { border: 1px solid #ccc; padding: 4px 6px; text-align: left; font-size: 9px; }
        table.dados th { background: #333; color: #fff; font-weight: bold; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .nowrap { white-space: nowrap; }
        .total-row td { background: #eee; font-weight: bold; font-size: 10px; }
        .resumo { margin: 4px 0 10px 0; font-size: 10px; }
        .footer { margin-top: 20px; text-align: center; font-size: 8px; color: #666; border-top: 1px solid #ccc; padding-top: 8px; }
    </style>
</head>
<body>
    <div class="container">
        {% include 'relatorios/pdf/_header.html.twig' with {
            titulo: 'RELATÓRIO DE CONFERÊNCIA DE COBRANÇAS',
            subtitulo: 'Conferência para emissão de boletos',
            periodo: periodo|default(null)
        } %}

        <p class="resumo">
            <strong>{{ cobrancas|length }}</strong> cobrança(s) a emitir &middot;
            Valor total: <strong>{{ valor_total_formatado }}</strong>
        </p>

        <table class="dados">
            <thead>
                <tr>
                    <th width="28" class="text-center">#</th>
                    <th width="60">Contrato</th>
                    <th>Locatário</th>
                    <th width="90">Competência</th>
                    <th width="75" class="text-center">Vencimento</th>
                    <th width="90" class="text-right">Valor</th>
                </tr>
            </thead>
            <tbody>
                {% for c in cobrancas %}
                    <tr>
                        <td class="text-center">{{ loop.index }}</td>
                        <td>#{{ c.contrato }}</td>
                        <td>{{ c.locatario }}</td>
                        <td>{{ c.competencia }}</td>
                        <td class="text-center nowrap">{{ c.vencimento }}</td>
                        <td class="text-right nowrap">{{ c.valor_formatado }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center">Nenhuma cobrança.</td></tr>
                {% endfor %}
                <tr class="total-row">
                    <td colspan="5" class="text-right">Total</td>
                    <td class="text-right nowrap">{{ valor_total_formatado }}</td>
                </tr>
            </tbody>
        </table>

        {% include 'relatorios/pdf/_footer.html.twig' %}
    </div>
</body>
</html>
